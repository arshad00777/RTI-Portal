# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d

# Database
# DB_DIALECT can be "sqlite" (zero-config, default) or "postgres"
DB_DIALECT=sqlite
SQLITE_STORAGE=./data/rti.sqlite

# Only needed when DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rti_portal
DB_USER=postgres
DB_PASSWORD=postgres

# Notifications (mocked by default - logs to console/notifications table)
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# RTI application fee (INR)
RTI_APPLICATION_FEE=10
